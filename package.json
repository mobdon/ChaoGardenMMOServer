{
  "name": "chaogarden",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "start": "node index.js",
    "test:reference": "node --test tests/reference/*.test.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules/.pnpm",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@chaogarden/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.1.1"
  }
}
