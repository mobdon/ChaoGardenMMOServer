# API server environment — copy to apps/api/.env and fill in real secrets.
# NEVER commit the real .env file.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chaogarden
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me-with-a-random-32-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
