# Review-only local TLS endpoint. This does not listen on a LAN/public address.
# Do not change the bind/domain until the public release gates are satisfied.
{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

https://localhost:3443 {
    bind 127.0.0.1
    tls internal

    @session {
        method POST
        path /api/session
    }
    handle @session {
        reverse_proxy 127.0.0.1:3001
    }

    @socket {
        method GET
        path /ws
    }
    handle @socket {
        reverse_proxy 127.0.0.1:3001
    }

    # Default deny includes /metrics, /livez, /readyz, /api/status,
    # /api/assets/*, profiles, administration and local import tools.
    # No access logger: the legacy WebSocket URL contains a bearer token.
    handle {
        respond 404
    }
}
