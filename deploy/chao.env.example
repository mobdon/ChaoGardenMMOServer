# Draft single-authority service; copy only to a separate test data directory.
CHAO_DATA_DIR=/var/lib/chao
GAME_HOST=127.0.0.1
GAME_PORT=3001
CHAO_OWNER_BOOTSTRAP=0
CHAO_ALLOWED_ORIGINS=https://localhost:3443
CHAO_SHUTDOWN_STDIN=0
# Tune only against the measured report and representative workload.
CHAO_MAX_CONNECTIONS=100
CHAO_MAX_PROFILES=10000
CHAO_EVENT_CAPACITY=512
CHAO_SEND_TIMEOUT_MS=1000
CHAO_MAX_SNAPSHOT_BYTES=1048576
# Password-reset mail (Postmark HTTPS API). Leave unset to turn reset mail off.
# The token is a secret: set it only in the real env file, never in git.
POSTMARK_SERVER_TOKEN=
CHAO_MAIL_FROM=
# Public site address the reset link points at, e.g. https://example.com
CHAO_PUBLIC_URL=
