# Run from the server repository, or use an absolute data path.
CHAO_DATA_DIR=./data
GAME_HOST=127.0.0.1
GAME_PORT=3001
CHAO_OWNER_BOOTSTRAP=0
# Explicit browser origins when binding beyond loopback.
# CHAO_ALLOWED_ORIGINS=https://your-client.example
# Optional verified native animal/drive data: configure both or neither.
# CHAO_CARE_AUDIT_DIR=C:/path/to/client/.local/care
# CHAO_CARE_EXECUTABLE=C:/path/to/Steam/steamapps/common/Sonic Adventure 2/sonic2app.exe
