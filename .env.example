# Run from the server repository, or use an absolute data path.
CHAO_DATA_DIR=./data
GAME_HOST=127.0.0.1
GAME_PORT=3001
CHAO_OWNER_BOOTSTRAP=0
# Explicit browser origins when binding beyond loopback.
# CHAO_ALLOWED_ORIGINS=https://your-client.example
# Admission bounds are not capacity claims. See docs/CAPACITY.md before tuning.
CHAO_MAX_CONNECTIONS=600
CHAO_MAX_PROFILES=10000
CHAO_EVENT_CAPACITY=512
CHAO_SEND_TIMEOUT_MS=1000
CHAO_MAX_SNAPSHOT_BYTES=1048576
